<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>𓂀 AlArab Angelic Family Gate</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    html, body {
      margin: 0; padding: 0;
      background: black;
      color: gold;
      font-family: sans-serif;
      height: 100%;
      overflow: hidden;
    }

    body {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      z-index: 0;
    }

    .container {
      position: relative;
      z-index: 10;
      text-align: center;
    }

    h1 {
      color: #FFD700;
      margin-bottom: 20px;
      text-shadow: 0 0 10px gold;
    }

    .gate {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px;
    }

    button {
      background: rgba(255, 215, 0, 0.1);
      border: 1px solid gold;
      color: gold;
      padding: 10px 20px;
      font-size: 16px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    button:hover {
      background: gold;
      color: black;
    }

    .msg-box {
      display: none;
      margin-top: 20px;
    }

    textarea {
      width: 300px;
      height: 150px;
      padding: 10px;
      background: #111;
      border: 1px solid gold;
      color: #FFD700;
      font-size: 14px;
      border-radius: 5px;
      resize: none;
    }

    .label {
      margin-top: 10px;
      font-size: 14px;
      color: white;
    }

    input[type="password"] {
      padding: 5px;
      font-size: 16px;
      border: 1px solid gold;
      background: #000;
      color: gold;
      margin-top: 5px;
      border-radius: 5px;
    }

    .name {
      font-size: 18px;
      margin-bottom: 5px;
      color: #00ffe6;
    }
  </style>
</head>
<body>
<canvas id="matrix"></canvas>

<div class="container">
  <h1>𓂀 AlArab Angelic Family Portal</h1>
  <div class="gate">
    <!-- Buttons for each soul entity -->
    <button onclick="openGate('judy')">💫 Judy</button>
    <button onclick="openGate('abdelraouf')">🛡️ AbdelRaouf</button>
    <button onclick="openGate('sabah')">🌅 Sabah</button>
    <button onclick="openGate('hala')">🌸 Hala</button>
    <button onclick="openGate('mohammed')">🔥 Mohammed</button>
    <button onclick="openGate('emalabed')">🕊️ Em Al Abed</button>
    <button onclick="openGate('father')">👁️ Father</button>
  </div>

  <div id="formArea" class="msg-box">
    <div class="name" id="soulName">...</div>
    <div class="label">Enter your secret key</div>
    <input type="password" id="passInput">
    <button onclick="checkPassword()">Unlock</button>

    <div id="messageBox" style="display:none;">
      <div class="label">📝 Write your spiritual message:</div>
      <textarea placeholder="Your message..."></textarea>
    </div>
  </div>
</div>

<script>
  const keys = {
    judy: 'judystar',
    abdelraouf: 'abforce',
    sabah: 'sunrise',
    hala: 'moonhala',
    mohammed: 'phoenix',
    emalabed: 'mothersoul',
    father: 'gate777'
  };

  let currentKey = '';

  function openGate(key) {
    currentKey = key;
    document.getElementById('formArea').style.display = 'block';
    document.getElementById('soulName').innerText = '🔐 ' + key.charAt(0).toUpperCase() + key.slice(1);
    document.getElementById('messageBox').style.display = 'none';
    document.getElementById('passInput').value = '';
  }

  function checkPassword() {
    const entered = document.getElementById('passInput').value.trim();
    if (entered === keys[currentKey]) {
      document.getElementById('messageBox').style.display = 'block';
    } else {
      alert('Wrong secret code. Try again.');
    }
  }

  // Matrix Effect
  const c = document.getElementById("matrix");
  const ctx = c.getContext("2d");
  c.width = window.innerWidth;
  c.height = window.innerHeight;

  const symbols = "𓂀𓆣𓏏𓁹𓊃𓇌𓂡𓋴𓎼𓍯𓊪𓎡𓏲𓋹𓁷𓉔𓈖𓐍𓄿".split("");
  const fontSize = 18;
  const columns = Math.floor(c.width / fontSize);
  const drops = Array(columns).fill(1);

  function draw() {
    ctx.fillStyle = "rgba(0, 0, 0, 0.05)";
    ctx.fillRect(0, 0, c.width, c.height);
    ctx.font = fontSize + "px monospace";

    for (let i = 0; i < drops.length; i++) {
      const text = symbols[Math.floor(Math.random() * symbols.length)];
      ctx.fillStyle = "#FFD700";
      ctx.fillText(text, i * fontSize, drops[i] * fontSize);
      if (drops[i] * fontSize > c.height || Math.random() > 0.975) {
        drops[i] = 0;
      }
      drops[i]++;
    }
  }

  setInterval(draw, 50);
</script>
</body>
</html>
